# Required. Admin login password/token for /admin and admin APIs.
AETHER_POOL_ADMIN_TOKEN=change-this-admin-password

# Required. Keep stable after first deployment, otherwise encrypted account auth files cannot be decrypted.
AETHER_POOL_SECRET_KEY=change-this-long-random-secret

# API is published only on localhost by default. Baota Nginx should proxy to this port.
AETHER_POOL_API_BIND=127.0.0.1
AETHER_POOL_API_PORT=8318

# For same-domain Baota deployment, leave VITE_API_BASE empty so the frontend calls /api.
VITE_API_BASE=

# If the frontend and API are same-origin behind Baota Nginx, this can stay empty.
# If you expose API cross-origin, set it to your frontend origin, e.g. https://pool.example.com
AETHER_POOL_CORS_ORIGINS=

# Optional OAuth refresh settings.
AETHER_POOL_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
AETHER_POOL_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token

RUST_LOG=aether_pool_api=info,tower_http=info
