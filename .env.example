# Required. Admin login password for /alalalateam and admin APIs.
# Replace this example value. The API refuses the placeholder.
AETHER_POOL_ADMIN_TOKEN=change-this-admin-password

# Required. Keep stable after first deployment, otherwise encrypted account auth files cannot be decrypted.
# Replace this example value and keep it backed up. The API refuses the placeholder.
AETHER_POOL_SECRET_KEY=change-this-long-random-secret

# App is published only on localhost by default. Baota Nginx should proxy to this port.
AETHER_POOL_API_BIND=127.0.0.1
AETHER_POOL_API_PORT=8318

# Published Docker image version used by docker-compose.yml.
AETHER_POOL_IMAGE_TAG=v0.1.0

# Same-origin deployment: keep VITE_API_BASE empty so frontend calls /api on the same Rust server.
# Separate frontend/API origins: set VITE_API_BASE to the public API origin.
# Then set AETHER_POOL_CORS_ORIGINS below to the public frontend origin.
VITE_API_BASE=
VITE_DEV_API_TARGET=http://127.0.0.1:8318

# Comma-separated public frontend origins allowed to call the API directly.
# Keep empty for same-origin reverse proxy deployment.
AETHER_POOL_CORS_ORIGINS=

# Optional OAuth refresh overrides. Leave omitted for the built-in ChatGPT defaults.
# AETHER_POOL_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# AETHER_POOL_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
AETHER_POOL_IP_CHECK_URL=https://api.ipify.org?format=json

RUST_LOG=aether_pool_api=info,tower_http=info
