# Empty means the frontend calls same-origin /api and /health.
# Set this when frontend and API are deployed on different origins.
VITE_API_BASE=

# Local dev proxy target used by vite.config.ts.
# Keep VITE_API_BASE empty during dev if you want Vite to proxy /api for you.
VITE_DEV_API_TARGET=http://127.0.0.1:8318
